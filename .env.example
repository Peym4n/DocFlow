# Copy to .env and set your own local password. These values are examples, not real secrets.
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=8080
SPRING_PROFILES_ACTIVE=
MINIO_ROOT_USER=docflow-storage
MINIO_ROOT_PASSWORD=change-me-storage-local-only
MINIO_PORT=9000
MINIO_BUCKET=docflow
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PAGES=100

# API startup uses ddl-auto=create and clears its mapped tables even with a persistent volume.
